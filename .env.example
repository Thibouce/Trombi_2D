# Copie ce fichier en ".env" et renseigne ta clé API Google AI Studio / Gemini.
# La clé reste côté serveur (proxy) et n'est jamais exposée au navigateur.

GEMINI_API_KEY=colle-ta-cle-ici

# Modèle d'édition d'image. Par défaut : nanoBanana Pro (Gemini 3 Pro Image).
# Alternative "nano banana" standard : gemini-2.5-flash-image
GEMINI_MODEL=gemini-3-pro-image-preview
