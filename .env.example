# Copie ce fichier en ".env" et renseigne ta clé API fal.ai.
# La clé reste côté serveur (proxy) et n'est jamais exposée au navigateur.
# Récupère ta clé sur https://fal.ai/dashboard/keys

FAL_KEY=colle-ta-cle-fal-ici

# Modèle d'édition d'image (fal.ai). Par défaut : GPT Image 2 edit.
FAL_MODEL=openai/gpt-image-2/edit

# Taille de sortie. Pour préserver l'équirectangulaire, garde un ratio 2:1.
# Défaut : 3840x1920 (4K, résolution maximale).
#  - dimensions explicites : "3840x1920" (défaut), "2048x1024", "1536x768"...
#  - ou un enum gpt-image-2 : landscape_16_9, landscape_4_3, square_hd, auto...
FAL_IMAGE_SIZE=3840x1920

# (Optionnel) Qualité de sortie : low | medium | high | auto
# FAL_QUALITY=high

# (Optionnel) Format de sortie : jpeg | png | webp
FAL_OUTPUT_FORMAT=jpeg
